# EmoGame 环境变量配置
# 复制为 .env 并填入实际值

# AutoDL API (LLM 语义分析，OpenAI 兼容接口)
AUTODL_TOKEN=xxx
AUTODL_BASE_URL=https://www.autodl.art/api/v1

# VLM defaults (Phase 1)
L1_MODEL=qwen2.5vl:3b
L2_MODEL=qwen2.5vl:3b
L3_MODEL=gpt-5.4-mini

# 数据库 (开发环境默认使用 SQLite)
DATABASE_URL=sqlite:///data/emogame.db

# Redis (缓存 + 消息队列)
REDIS_URL=redis://localhost:6379

# VLM 模型目录 (本地模型存放路径)
VLM_MODEL_DIR=/models

# 百度指数 API (可选)
BAIDU_INDEX_API_KEY=

# Bilibili API (可选)
BILIBILI_API_KEY=

# How to obtain your Weibo cookie:
#
# 1. Open Chrome and visit https://m.weibo.cn/
# 2. Log in to your Weibo account
# 3. Press F12 → Application → Cookies → https://m.weibo.cn
# 4. Copy the cookie string (Name=Value pairs separated by "; ")
# 5. Paste it below and save this file as .secret
#
# Detailed instructions: https://github.com/dataabc/weiboSpider#如何获取cookie
#
# Replace this line with your actual cookie:
# 注意：代码统一从 WEIBO_COOKIE 读取，不再使用 weiboSpider/.secret
WEIBO_COOKIE=

# 日志级别
LOG_LEVEL=INFO
